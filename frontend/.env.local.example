# ==============================================================================
# NEXAURA PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=nexaura_admin
POSTGRES_PASSWORD=nexaura_secure_password_2026
POSTGRES_DB=nexaura_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexaura_admin:nexaura_secure_password_2026@localhost:5432/nexaura_db?schema=public

# ------------------------------------------------------------------------------
# APPLICATION CLIENT & CORS
# ------------------------------------------------------------------------------
WEB_CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT & Cookies)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=super_secret_access_jwt_key_minimum_32_characters_long_1234
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_minimum_32_characters_long_5678
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_key_random_salt_1234567890
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# SUPER ADMIN INITIAL SEED (Allowed Non-Fake Seed)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@nexaura.gov.in
ADMIN_PASSWORD=SuperAdmin@Nexaura2026!
ADMIN_NAME=Nexaura Super Administrator

# ------------------------------------------------------------------------------
# AI INTEGRATION (Anthropic Claude API - Server-side only)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_INTERVIEW_MAX_QUESTIONS=6

# ------------------------------------------------------------------------------
# EMAIL DELIVERY (Nodemailer SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME="NEXAURA Career Platform"
EMAIL_FROM_ADDRESS="no-reply@nexaura.gov.in"

# ------------------------------------------------------------------------------
# FILE STORAGE (Local disk interface; S3-ready)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg

# ------------------------------------------------------------------------------
# COMPANY VERIFICATION PROVIDERS (Licensed / Gov data APIs)
# ------------------------------------------------------------------------------
# Leave blank for "MANUAL_REVIEW" fallback (no fake data)
GST_API_PROVIDER=mock_licensed_gstin_gateway
GST_API_KEY=
GST_API_URL=https://api.gst.gov.in/v1/authenticate

MCA_API_PROVIDER=mock_mca_gateway
MCA_API_KEY=
MCA_API_URL=https://mca.gov.in/api/v1/company

# ------------------------------------------------------------------------------
# BACKGROUND JOBS & MATCHING PARAMETERS
# ------------------------------------------------------------------------------
QUIZ_COOLDOWN_DAYS=7
MIN_APPROVED_QUESTIONS_PER_SKILL=5
MATCH_WEIGHT_SKILLS=0.45
MATCH_WEIGHT_PREFERENCES=0.25
MATCH_WEIGHT_LOCATION=0.15
MATCH_WEIGHT_VERIFICATION=0.15
